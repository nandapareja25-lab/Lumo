# Copiar a .env.local (nunca commitear .env.local — ya está en .gitignore)

# Panel /admin — contraseña temporal mientras no existe auth real (Sesión 4/6)
ADMIN_PASSWORD=

# OpenAI Images API (gpt-image-1) — usada SOLO desde /admin/landing para generar
# las escenas de la landing. Sin esta clave, el botón "Generar vista previa" avisa
# que falta configurarla — no rompe el resto de la app.
OPENAI_API_KEY=

# Pendiente de Sesión 6 (servicios externos) — hoy las imágenes aprobadas se guardan
# en /public/lumo-art y en data/landing-assets.json, no en Supabase todavía.
# NEXT_PUBLIC_SUPABASE_URL=
# NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# SUPABASE_URL=
# SUPABASE_SECRET_KEY=
